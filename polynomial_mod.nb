  3.89963448488685*^9},
 CellLabel->"Out[58]=",ExpressionUUID->"ac03875d-8bef-4688-bc11-7212edf73757"]
}, Open  ]],

Cell[TextData[{
 "We can then ask ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to do a polynomial mod calculation to compare to our own result from ",
 StyleBox["bit::polynomial_mod(N,p).to_polynomial()", "Program"]
}], "Text",
 CellChangeTimes->{{3.899634738256544*^9, 
  3.899634830365786*^9}},ExpressionUUID->"c71b3e04-1fe0-4b69-8d05-\
e104bef7007d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PolynomialMod", "[", 
  RowBox[{
   RowBox[{"x", "^", "447124345"}], ",", 
   RowBox[{"p", "[", "x", "]"}], ",", " ", 
   RowBox[{"Modulus", "->", "2"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.89955141774301*^9, 3.899551513968972*^9}, {
   3.899551605249378*^9, 3.899551620096521*^9}, 3.899551667411794*^9, 
